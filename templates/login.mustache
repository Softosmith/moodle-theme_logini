{{!
    @template theme_logini/login

    Logini split-screen login page template.

    Example context (json):
    {
        "sitename": "Logini",
        "currentyear": "2026",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Sign In",
            "favicon": "favicon.ico",
            "main_content": "<div class='loginbox'>...</div>"
        }
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div class="logini-login-page">

        {{! ===== LEFT PANEL: Login Form ===== }}
        <div class="logini-login-left">

            {{! Logo }}
            <div class="logini-login-logo">
                {{#loginlogo_icon}}
                <div class="logini-login-logo-icon">
                    <i class="fa {{loginlogoiconclass}}" aria-hidden="true"></i>
                </div>
                {{/loginlogo_icon}}
                {{#loginlogo_name}}
                <span class="logini-login-logo-text">{{sitename}}</span>
                {{/loginlogo_name}}
            </div>

            {{! Form container }}
            <div class="logini-login-form-wrap">

                {{! Heading block }}
                <div class="logini-login-heading-block">
                    <div class="logini-login-avatar-icon">
                        <i class="fa fa-user-o" aria-hidden="true"></i>
                    </div>
                    <h2 class="logini-login-title">{{loginheadingtext}}</h2>
                    <p class="logini-login-subtitle">{{loginsubtitletext}}</p>
                </div>

                {{! Social login buttons -- dynamically rendered from real OAuth 2 issuers }}
                {{#hassocialbuttons}}
                {{^loginhidesocial}}
                <div class="logini-social-buttons">
                    {{#socialbuttons}}
                    <a class="logini-social-btn" href="{{url}}">
                        {{#is_google}}
                        <svg class="logini-social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        {{/is_google}}
                        {{#is_microsoft}}
                        <svg class="logini-social-icon" viewBox="0 0 21 21" aria-hidden="true">
                            <rect x="1" y="1" width="9" height="9" fill="#F25022"/>
                            <rect x="11" y="1" width="9" height="9" fill="#7FBA00"/>
                            <rect x="1" y="11" width="9" height="9" fill="#00A4EF"/>
                            <rect x="11" y="11" width="9" height="9" fill="#FFB900"/>
                        </svg>
                        {{/is_microsoft}}
                        {{#is_facebook}}
                        <svg class="logini-social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.269h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" fill="#1877F2"/>
                        </svg>
                        {{/is_facebook}}
                        {{#is_linkedin}}
                        <svg class="logini-social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="#0A66C2"/>
                        </svg>
                        {{/is_linkedin}}
                        {{name}}
                    </a>
                    {{/socialbuttons}}
                </div>
                {{/loginhidesocial}}
                {{/hassocialbuttons}}

                {{! OR divider -- only shown when social buttons are present }}
                {{#hassocialbuttons}}
                {{^loginhideordivider}}
                <div class="logini-or-divider">
                    <div class="logini-or-line"></div>
                    <span class="logini-or-text">{{#str}} or, theme_logini {{/str}}</span>
                    <div class="logini-or-line"></div>
                </div>
                {{/loginhideordivider}}
                {{/hassocialbuttons}}

                {{! Moodle login form output (includes form, errors, forgot password, sign up link, OAuth2 providers) }}
                {{{ output.main_content }}}

            </div>

            {{! Page footer }}
            <div class="logini-login-footer">
                {{#loginfootertext}}
                <span>{{{loginfootertext}}}</span>
                {{/loginfootertext}}
                {{^loginfootertext}}
                <span>&copy; {{currentyear}} {{sitename}}</span>
                {{/loginfootertext}}
                {{#langmenu}}
                    {{> theme_boost/language_menu }}
                {{/langmenu}}
            </div>

        </div>

        {{! ===== RIGHT PANEL: Brand Visual ===== }}
        <div class="logini-login-right" aria-hidden="true">

            {{! Grid pattern overlay }}
            <div class="logini-bg-grid"></div>

            {{! Floating course preview cards }}
            {{^loginhidecards}}
            <div class="logini-cards-scene">

                {{! Background card -- progress / bar chart }}
                <div class="logini-card logini-card-back">
                    <div class="logini-card-header">
                        <span class="logini-card-label">{{#str}} progress, theme_logini {{/str}}</span>
                        <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                    </div>
                    <div class="logini-card-avatar-block">
                        <img
                            class="logini-card-avatar-img"
                            src="{{demoavatarurl}}"
                            alt=""
                        />
                        <h4 class="logini-card-name">{{#str}} card_name, theme_logini {{/str}}</h4>
                        <p class="logini-card-role">{{#str}} card_role, theme_logini {{/str}}</p>
                    </div>
                    <div class="logini-bar-chart">
                        <div class="logini-bar" style="height:32px"></div>
                        <div class="logini-bar" style="height:64px"></div>
                        <div class="logini-bar" style="height:48px"></div>
                        <div class="logini-bar" style="height:24px"></div>
                    </div>
                </div>

                {{! Foreground card -- course preview }}
                <div class="logini-card logini-card-front">
                    <div class="logini-card-thumb">
                        <div class="logini-card-thumb-inner">
                            <div class="logini-card-thumb-icon-wrap">
                                <i class="fa fa-paint-brush" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                    <h3 class="logini-card-course-title">{{logincardcourse}}</h3>
                    <p class="logini-card-course-desc">
                        {{logincarddesc}}
                    </p>
                    <div class="logini-card-meta">
                        <div class="logini-card-meta-left">
                            <span class="logini-meta-tag">
                                <span class="logini-meta-dot"></span>
                                {{logincardlevel}}
                            </span>
                            <span class="logini-meta-tag">
                                <i class="fa fa-clock-o" aria-hidden="true"></i>
                                {{logincardduration}}
                            </span>
                        </div>
                        <span class="logini-card-rating">
                            <i class="fa fa-star" aria-hidden="true"></i> {{logincardrating}} <small>({{logincardratingcount}})</small>
                        </span>
                    </div>
                </div>

                {{! Floating decorative icon bubbles }}
                <div class="logini-float-icon logini-float-icon--blue">
                    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                </div>
                <div class="logini-float-icon logini-float-icon--purple">
                    <i class="fa fa-laptop" aria-hidden="true"></i>
                </div>
                <div class="logini-float-icon logini-float-icon--orange">
                    <i class="fa fa-book" aria-hidden="true"></i>
                </div>

            </div>
            {{/loginhidecards}}

            {{! Brand copy slider }}
            {{^loginhideslider}}
            <div class="logini-brand-slider">
                {{#hasslide1}}
                <div class="logini-slide {{slide1active}}">
                    {{#loginslide1imageurl}}<div class="logini-slide-image-wrap"><img src="{{loginslide1imageurl}}" alt=""></div>{{/loginslide1imageurl}}
                    {{#loginslide1heading}}<h2 class="logini-brand-headline">{{loginslide1heading}}</h2>{{/loginslide1heading}}
                    {{#loginslide1body}}<p class="logini-brand-body">{{loginslide1body}}</p>{{/loginslide1body}}
                </div>
                {{/hasslide1}}
                {{#hasslide2}}
                <div class="logini-slide {{slide2active}}">
                    {{#loginslide2imageurl}}<div class="logini-slide-image-wrap"><img src="{{loginslide2imageurl}}" alt=""></div>{{/loginslide2imageurl}}
                    {{#loginslide2heading}}<h2 class="logini-brand-headline">{{loginslide2heading}}</h2>{{/loginslide2heading}}
                    {{#loginslide2body}}<p class="logini-brand-body">{{loginslide2body}}</p>{{/loginslide2body}}
                </div>
                {{/hasslide2}}
                {{#hasslide3}}
                <div class="logini-slide {{slide3active}}">
                    {{#loginslide3imageurl}}<div class="logini-slide-image-wrap"><img src="{{loginslide3imageurl}}" alt=""></div>{{/loginslide3imageurl}}
                    {{#loginslide3heading}}<h2 class="logini-brand-headline">{{loginslide3heading}}</h2>{{/loginslide3heading}}
                    {{#loginslide3body}}<p class="logini-brand-body">{{loginslide3body}}</p>{{/loginslide3body}}
                </div>
                {{/hasslide3}}
                {{#showdots}}
                <div class="logini-pagination-dots">
                    {{#hasslide1}}<span class="logini-dot {{dot1active}}" data-slide="0"></span>{{/hasslide1}}
                    {{#hasslide2}}<span class="logini-dot {{dot2active}}" data-slide="1"></span>{{/hasslide2}}
                    {{#hasslide3}}<span class="logini-dot {{dot3active}}" data-slide="2"></span>{{/hasslide3}}
                </div>
                {{/showdots}}
            </div>
            {{#js}}
            require(['theme_logini/brand-slider'], function(S) { S.init(); });
            {{/js}}
            {{/loginhideslider}}

            {{! Bottom gradient overlay }}
            <div class="logini-right-gradient"></div>

        </div>

    </div>

    {{> theme_boost/footer }}

</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
